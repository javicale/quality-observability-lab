{
  "name": "quality-observability-lab",
  "version": "0.1.0",
  "description": "Learning lab correlating Playwright execution with OpenTelemetry traces, logs, metrics and failure evidence",
  "scripts": {
    "start": "node src/server.js",
    "check": "node scripts/check.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "demo": "node scripts/run-lab.js",
    "test": "npm run check && npm run test:unit && npm run demo",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javicale/quality-observability-lab.git"
  },
  "keywords": [],
  "author": "Javier Capa",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/javicale/quality-observability-lab/issues"
  },
  "homepage": "https://github.com/javicale/quality-observability-lab#readme",
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "private": true
}
